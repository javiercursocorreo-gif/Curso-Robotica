!BLOQUE-5_Androides/5.3_Androide_MIXAMO/1.FICHEROS-AUXILIARES/MIXAMO/**/*.glb
!BLOQUE-5_Androides/5.3_Androide_MIXAMO/1.FICHEROS-AUXILIARES/MP3/
!BLOQUE-5_Androides/5.3_Androide_MIXAMO/1.FICHEROS-AUXILIARES/MP3/*.mp3

# 8. Excepciones para simuladores 3D de Dron (Bloque 3.4)
!BLOQUE-3_Movimiento-Avanzado/3.4_Dron. (Tres-dimensiones)/3.PRACTICAS/P1_CONSTRUCCION/*.js
!BLOQUE-3_Movimiento-Avanzado/3.4_Dron. (Tres-dimensiones)/3.PRACTICAS/P3_SIMULADOR_VUELO/*.js

# 9. Excepciones para Transformer 3D de Bloque 5.4
